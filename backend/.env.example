# Tiger Data service connection string (Postgres + TimescaleDB). Copy it from
# the service dashboard; TLS is required and added automatically if absent.
# A local Postgres also works for the relational tables, but the hypertables
# in scripts/init_tigerdata.py need the timescaledb extension.
DATABASE_URL=postgresql://user:password@host.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=   # set after running: python scripts/seed_nessie.py

GEMINI_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

VECTORMINT_API_KEY=

JWT_SECRET=changeme
